# PlayMint Local Configuration Template
# Copy this file to '.env' in the same directory and paste your API key below:
# (Note: Keys prefixed with VITE_ are compiled client-side in Vite applications)

# SEELE AI API Key (Required for image generation)
# Get your API key from: https://seeles.ai
# Make sure you have sufficient Koin credits for generation
VITE_SEELE_API_KEY=your_seele_api_key_here

# Optional: SEELE Proxy URL (if using custom proxy)
# VITE_SEELE_PROXY_URL=http://localhost:3001/api

