# PlayMint Local Configuration Template
# Copy this file to '.env' in the same directory and paste your API keys below.
# (Note: Keys prefixed with VITE_ are compiled client-side in Vite applications)

# Gemini API Key (recommended — enables AI asset generation + prompt design)
# Get your key from: https://aistudio.google.com/apikey
# Without it the app still works, falling back to the free Pollinations image engine.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Pollinations API key (authorizes fallback image requests; not required)
# VITE_POLLINATIONS_API_KEY=your_pollinations_key_here

# Optional: force the free Pollinations path even when a Gemini key is set
# (evaluation mode). Vite inlines env vars at server start — restart `npm run dev`
# after changing this. Remove the line (or set 0) and restart to re-enable Gemini.
# VITE_FORCE_POLLINATIONS=1
